rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The map and events page are public catalog views. Catalog content is
    // managed outside the client and must never be writable from the app.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Bookings are private to their authenticated owner. The userId check on
    // create/update also prevents a client from claiming another user's UID.
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Deny every collection that is not explicitly exposed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }
}